{
  "name": "zca-bridge",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/store/migrations dist/store/ && mkdir -p dist/admin && cp -r src/admin/public dist/admin/",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/store/migrate.ts",
    "check:no-pro": "tsx scripts/checkNoPro.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "fastify": "^5.2.0",
    "https-proxy-agent": "^9.1.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.5",
    "socks-proxy-agent": "^10.1.0",
    "undici": "^8.13.1",
    "zca-js": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.1.1"
  }
}
